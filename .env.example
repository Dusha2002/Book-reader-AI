# Recommended: one OpenRouter key for all API roles.
OPENROUTER_API_KEY=sk-or-v1-your-key
BOOKAI_BASE_URL=https://openrouter.ai/api/v1
BOOKAI_REASONING=none

# Cascade roles. Cheap model handles most tokens; Qwen sees only flagged passages.
BOOKAI_TRANSLATOR_BACKEND=api
BOOKAI_TRANSLATOR_MODEL=deepseek/deepseek-v4-flash-0731
BOOKAI_ANALYZER_MODEL=deepseek/deepseek-v4-flash-0731
BOOKAI_GATE_MODEL=deepseek/deepseek-v4-flash-0731
BOOKAI_MEMORY_MODEL=deepseek/deepseek-v4-flash-0731
BOOKAI_EDITOR_MODEL=qwen/qwen3.8-flash
BOOKAI_HARD_MODEL=deepseek/deepseek-v4-pro-0813
BOOKAI_LLM_GATE=true

# Optional zero-API base translation (requires `pip install -e '.[local]'`).
# BOOKAI_TRANSLATOR_BACKEND=madlad
# BOOKAI_MADLAD_MODEL=google/madlad400-3b-mt
# BOOKAI_LOCAL_DEVICE=auto
