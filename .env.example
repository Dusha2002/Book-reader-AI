# Any OpenAI-compatible Chat Completions API. DeepSeek V4 Flash is the default.
BOOKAI_API_KEY=your_key_here
BOOKAI_BASE_URL=https://api.deepseek.com
BOOKAI_MODEL=deepseek-v4-flash
# DeepSeek V4 enables thinking by default; this project disables it by default for predictable cost/latency.
BOOKAI_THINKING=disabled
